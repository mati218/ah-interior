generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  blogPosts BlogPost[]
}

model Category {
  id   String @id @default(cuid())
  name String
  slug String @unique

  projects Project[]
}

model Project {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  summary     String
  description String
  coverImage  String
  location    String?
  area        String?
  year        Int?
  featured    Boolean       @default(false)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?

  images        ProjectImage[]
  testimonials  Testimonial[]
}

model ProjectImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int     @default(0)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String
  description String
  icon        String?
  image       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  role       String?
  message    String
  avatar     String?
  rating     Int      @default(5)
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
}

model TeamMember {
  id          String  @id @default(cuid())
  name        String
  role        String
  bio         String?
  photo       String?
  sortOrder   Int     @default(0)
  socialLinks Json?
}

model BlogPost {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String
  content     String
  coverImage  String
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?
}

model Lead {
  id          String     @id @default(cuid())
  name        String
  email       String
  phone       String?
  message     String
  projectType String?
  status      LeadStatus @default(NEW)
  createdAt   DateTime   @default(now())
}

model SiteSetting {
  key   String @id
  value Json
}
